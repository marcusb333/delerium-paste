# Template — copy to secret.yaml and fill in real values before applying.
# Quickstart: make k8s-setup  (interactive, generates values and writes secret.yaml)
# Apply with: kubectl apply -f k8s/server/secret.yaml
#
# For production prefer a secrets manager (Sealed Secrets, External Secrets, etc.)
# and never commit real values to source control.
apiVersion: v1
kind: Secret
metadata:
  name: delerium-server-secret
  namespace: delerium
type: Opaque
stringData:
  # Generate with: openssl rand -hex 32
  DELETION_TOKEN_PEPPER: "REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32"
  # JDBC connection URL.
  # SQLite example:    jdbc:sqlite:/data/pastes.db
  # PostgreSQL example: jdbc:postgresql://host:5432/delerium
  DB_PATH: "REPLACE_WITH_DB_PATH"
  # Leave empty for SQLite (no auth required)
  DB_USER: ""
  DB_PASSWORD: ""
