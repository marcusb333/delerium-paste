{
  "title": "Delerium",
  "uid": "delerium-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Paste Creation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(delerium_pastes_created_total[5m])",
        "legendFormat": "pastes/sec"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 2,
      "title": "Paste Views Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(delerium_pastes_viewed_total[5m])",
        "legendFormat": "views/sec"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (status) (rate(ktor_http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4,
      "title": "Rate Limit Hits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(delerium_ratelimit_hits_total[5m])",
        "legendFormat": "hits/sec"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "fixedColor": "orange", "mode": "fixed" } } }
    },
    {
      "id": 5,
      "title": "PoW Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(delerium_pow_failures_total[5m])",
        "legendFormat": "failures/sec"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 6,
      "title": "Delete Auth Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "rate(delerium_delete_auth_failures_total[5m])",
        "legendFormat": "failures/sec"
      }],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 7,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "heap used"
        },
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "heap max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8,
      "title": "HTTP Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ktor_http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ktor_http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ktor_http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "title": "HikariCP — Active / Idle Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 10,
      "title": "Nginx Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "nginx_connections_active",
        "legendFormat": "active"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
