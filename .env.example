# Delerium Environment Configuration
# Copy this file to .env and update with your values

# REQUIRED: Secret pepper for deletion token hashing
# Generate with: openssl rand -hex 32
DELETION_TOKEN_PEPPER=your-secret-pepper-here

# REQUIRED: PostgreSQL password (shared by the postgres and server services)
POSTGRES_PASSWORD=change-me-strong-password

# REQUIRED: Server DB password (must match POSTGRES_PASSWORD above)
DB_PASSWORD=change-me-strong-password

# Optional: Domain for SSL/TLS
DOMAIN=paste.example.com

# Optional: Email for Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com
